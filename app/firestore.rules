rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // v1 has no auth, so these rules can't check identity — they only
    // constrain *shape*, not *who*. Tighten this to require Firebase Auth
    // (e.g. request.auth.uid) before this app handles anything sensitive.

    match /channels/{channelId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(["name", "inviteCode", "ownerName"]);
      allow update, delete: if false;

      match /members/{memberId} {
        allow read: if true;
        allow write: if true;
      }

      match /clips/{clipId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasAll(["senderName", "downloadUrl", "durationMs"])
                       && request.resource.data.durationMs is number
                       && request.resource.data.durationMs < 60000; // cap a single clip at 60s
        allow update, delete: if false;
      }
    }

    match /channelsByCode/{code} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(["channelId"]);
      allow update, delete: if false;
    }
  }
}
